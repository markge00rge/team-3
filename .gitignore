# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local environment settings
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/

# Test, coverage, and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Local immutable scenario history and user-created optimization data
app_data/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
reports/app_runs/
.mypy_cache/
.ruff_cache/

# Notebook checkpoints
.ipynb_checkpoints/
